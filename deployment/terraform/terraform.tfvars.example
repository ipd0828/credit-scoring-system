# deployment/terraform/terraform.tfvars.example
# Пример файла переменных - скопируйте в terraform.tfvars и заполните

# Обязательные переменные
yandex_cloud_id = "b1g2liefv4c308kdj2cm"
yandex_folder_id = "b1gtp2vtkrplf280eu4g"

# Настройки окружения
environment = "dev"
cluster_name = "credit-scoring"

# Настройки сети
use_existing_network = true
vpc_cidr = "10.0.0.0/16"

# Настройки Kubernetes
k8s_version = "1.24"
min_node_count = 2
max_node_count = 3
node_cores = 2
node_memory = 4
node_disk_size = 50
preemptible_nodes = true

# Настройки Object Storage (для backend)
s3_access_key = ""  # Будет создан автоматически
s3_secret_key = ""  # Будет создан автоматически